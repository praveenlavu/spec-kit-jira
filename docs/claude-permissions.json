      "Bash(skj strict mode:*)",
      "Bash(skj kits verify:*)",
      "Bash(skj calibrate:*)",
      "Bash(skj branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git switch:*)",
      "Bash(.specify/scripts/bash/check-prerequisites.sh:*)",
